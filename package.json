{
  "name": "sudojo_bot",
  "version": "1.0.65",
  "description": "Microsoft Bot Framework bot for Sudoku hints",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test:unit": "bun test",
    "test:watch": "bun test --watch",
    "sync:hint-headings": "bun scripts/sync-hint-headings.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "~0.1.100",
    "@sudobility/sudojo_client": "^0.0.175",
    "@sudobility/sudojo_types": "^1.2.79",
    "@sudobility/types": "^1.9.76",
    "botbuilder": "~4.23.3",
    "botbuilder-dialogs": "~4.23.3",
    "i18next": "~26.5.7",
    "restify": "~11.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "~22.20.5",
    "@types/restify": "~8.5.12",
    "eslint": "~9.39.5",
    "globals": "~17.13.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sudojo_bot.git"
  }
}
